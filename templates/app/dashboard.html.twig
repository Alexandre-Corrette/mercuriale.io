{% extends 'layouts/app.html.twig' %}

{% block title %}Tableau de bord — Mercuriale.io{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin-dashboard.css') }}">
{% endblock %}

{% block content %}
<div class="dashboard-hub">
    <h1 class="dashboard-hub__title">Tableau de bord</h1>
    <p class="dashboard-hub__date">{{ current_date() }}</p>

    <div class="m-tile-grid">
        {# Bons de livraison — accessible à tous les rôles (consultation pour cuisinier) #}
        {% include 'components/_dashboard_tile.html.twig' with {
            label: 'Bons de livraison', icon: 'fa-file-invoice-dollar',
            url: path('app_bl_hub'), color: 'olive',
            badge_count: alerte_count
        } only %}

        {# Produits / Mercuriale — accessible à tous (consultation pour cuisinier) #}
        {% include 'components/_dashboard_tile.html.twig' with {
            label: 'Produits', icon: 'fa-basket-shopping',
            url: path('app_produits_hub'), color: 'purple'
        } only %}

        {# Fournisseurs — gestion réservée ROLE_GERANT et plus #}
        {% if is_granted('ROLE_GERANT') %}
            {% include 'components/_dashboard_tile.html.twig' with {
                label: 'Fournisseurs', icon: 'fa-handshake',
                url: path('app_fournisseurs_hub'), color: 'crimson'
            } only %}
        {% endif %}

        {# Avoirs fournisseur — gestion réservée ROLE_GERANT et plus #}
        {% if is_granted('ROLE_GERANT') %}
            {% include 'components/_dashboard_tile.html.twig' with {
                label: 'Avoirs', icon: 'fa-receipt',
                url: path('app_avoirs_hub'), color: 'orange'
            } only %}
        {% endif %}

        {# Factures fournisseur — gestion réservée ROLE_GERANT et plus #}
        {% if is_granted('ROLE_GERANT') %}
            {% include 'components/_dashboard_tile.html.twig' with {
                label: 'Factures', icon: 'fa-file-invoice',
                url: path('app_factures_hub'), color: 'forest'
            } only %}
        {% endif %}

        {# Profil — accessible à tous #}
        {% include 'components/_dashboard_tile.html.twig' with {
            label: 'Profil', icon: 'fa-id-card',
            url: path('app_profil_hub'), color: 'cyan'
        } only %}
    </div>
</div>
{% endblock %}
